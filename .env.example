# ============================================================
# 环境变量模板 — 复制本文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中，不会提交到 GitHub
# ============================================================

# --- Tushare API Token ---
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# --- 可选: 其他数据源 ---
# WIND_API_KEY=
# THS_API_KEY=

# --- 数据库配置 ---
DB_PATH=sqlite:///data_cache/limitup.db

# --- 日志级别: DEBUG / INFO / WARNING / ERROR ---
LOG_LEVEL=INFO

# --- 回测数据存储路径 ---
BACKTEST_DATA_DIR=data_cache/backtest

# --- VN.PY 配置（实盘时使用，回测不需要） ---
# CTP_BROKER_ID=
# CTP_TD_ADDRESS=
# CTP_MD_ADDRESS=
# CTP_APP_ID=
# CTP_AUTH_CODE=
